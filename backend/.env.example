# Local settings. Copy to .env (gitignored) and fill in; `make run` and the
# `make integration-test*` targets load it. The deployed service gets its values
# from Render (infra/render.yaml) instead.
#
# Plain KEY=value lines: no quotes, no spaces around "=", no "$" or "#" in values.

# --- Service (main.go) ---

# Port the HTTP server listens on.
PORT=8080
# X-API-Key required on /v1 endpoints. Empty disables auth, which the service
# refuses when GIN_MODE=release.
API_KEY=dev-key
# Initial acquirer routing order (the ranking's tie-break order), comma-separated.
# A subset such as AcquirerOne gives the single-acquirer baseline.
ACQUIRER_ORDER=AcquirerOne,AcquirerTwo,AcquirerThree
# false keeps ACQUIRER_ORDER fixed instead of reordering by recent approval rate.
DYNAMIC_RANKING=true
# Non-zero makes AcquirerThree's random approvals reproducible per request.
# Empty or 0 draws at random.
MOCK_ACQUIRER_SEED=
# debug (default) or release.
GIN_MODE=debug

# --- Integration tests against a deployed service (make integration-test-deployed) ---

INTEGRATION_BASE_URL=https://yuno-failover-api.onrender.com
# The deployed service's API_KEY: Render > yuno-failover-api > Environment.
INTEGRATION_API_KEY=
